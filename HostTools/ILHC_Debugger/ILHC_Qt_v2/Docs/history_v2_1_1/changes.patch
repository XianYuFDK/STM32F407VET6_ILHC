+        self.assertFalse(r['ok']); self.assertFalse(r['execution_safe']); self.assertEqual(r['points'],[])
+
+    def test_first_and_last_connectors_checked(self):
+        r=core.plan_path((390,1110),(1170,640))
+        if r['ok']:
