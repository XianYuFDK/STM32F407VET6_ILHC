-    x0, y0, x1, y1 = bounds if bounds else (0.0, 0.0, FIELD_SIZE, FIELD_SIZE)
-    step = max(10.0, float(grid))
-    pad = max(0.0, float(pad))
-    rects, circles = obstacles_with_pad(pad, rects, circles)
-    nx = int(round((x1 - x0) / step)) + 1
-    ny = int(round((y1 - y0) / step)) + 1
-    blocked = [[blocked_at(x0 + i * step, y0 + j * step, rects, circles) is not None
-                for j in range(ny)] for i in range(nx)]
-
-    start = (float(start[0]), float(start[1]))
-    goal = (float(goal[0]), float(goal[1]))
-    fail = {"ok": False, "points": [], "raw": [], "length": 0.0, "grid": step, "pad": pad,
-            "expanded": 0, "min_clearance": None, "start_in_inflate": None,
-            "goal_in_inflate": None}
-    if (start[0] < x0 or start[0] > x1 or start[1] < y0 or start[1] > y1 or
-            goal[0] < x0 or goal[0] > x1 or goal[1] < y0 or goal[1] > y1):
-        return dict(fail, reason="起点或目标超出场地范围")
-
-    # 起点/目标落在"膨胀后"的禁区里：仍允许规划，但要报出来（末端/首端无法完全贴靠）
-    start_in = blocked_at(start[0], start[1], rects, circles)
-    goal_in = blocked_at(goal[0], goal[1], rects, circles)
