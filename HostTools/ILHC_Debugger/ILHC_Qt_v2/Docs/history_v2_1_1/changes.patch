-def plan_path(start, goal, grid=GRID_MM, pad=CAR_INFLATE_MM,
-              rects=None, circles=None, bounds=None):
-    """A* 规划一条避开设场固定禁区的路径。
-
-    start/goal：(x, y) 场地 mm，与 ZONE_CENTER / 禁区矩形同一帧。
-    grid / pad：网格步长、车体膨胀量（mm）。
-    返回 dict：ok / points（含起点终点的航点表，已拉直）/ raw（网格原始路径）/
