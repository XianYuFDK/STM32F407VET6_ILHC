+                            bounds=(0,0,2400,2400),pad=150)
+        else:
+            self.assertIn(r['code'],('INVALID_START','INVALID_GOAL','NO_CONNECTION','NO_PATH'))
+
+    def test_coarse_grid_edge_cannot_jump_over_cylinder(self):
