-    gn = _snap_free(goal[0], goal[1], x0, y0, step, blocked, nx, ny)
-    if sn is None:
-        return dict(fail, reason="起点周围没有可用网格（禁区太密）")
-    if gn is None:
-        return dict(fail, reason="目标点周围没有可用网格（禁区太密）")
-
-    def node(i, j):
-        return (x0 + i * step, y0 + j * step)
-
-    def heur(i, j):
-        return math.hypot((i - gn[0]) * step, (j - gn[1]) * step)
-
-    openq = [(heur(*sn), 0.0, sn)]
-    came = {sn: None}
-    gscore = {sn: 0.0}
-    expanded = 0
-    while openq:
-        _, g, cur = heapq.heappop(openq)
-        if g > gscore.get(cur, float("inf")):
-            continue
-        expanded += 1
-        if cur == gn:
-            break
-        for di in (-1, 0, 1):
-            for dj in (-1, 0, 1):
-                if di == 0 and dj == 0:
-                    continue
-                i, j = cur[0] + di, cur[1] + dj
-                if not (0 <= i < nx and 0 <= j < ny) or blocked[i][j]:
-                    continue
-                # 斜向不允许切角：否则路径会贴着障碍拐角"削"进去
-                if di and dj and (blocked[cur[0] + di][cur[1]] or blocked[cur[0]][cur[1] + dj]):
-                    continue
-                ng = g + math.hypot(di, dj) * step
-                if ng < gscore.get((i, j), float("inf")):
-                    gscore[(i, j)] = ng
-                    came[(i, j)] = cur
-                    heapq.heappush(openq, (ng + heur(i, j), ng, (i, j)))
-    else:
-        return dict(fail, expanded=expanded,
-                    reason="没有可行路径（禁区把通路封死，可调小膨胀或改目标）")
-
-    cells = []
-    cur = gn
-    while cur is not None:
-        cells.append(cur)
-        cur = came[cur]
-    cells.reverse()
-    # 用精确的起点/终点替换吸附后的首尾网格点
-    raw = [start] + [node(i, j) for i, j in cells[1:-1]] + [goal]
-    points = simplify_path(raw, rects, circles)
-    return {"ok": True, "points": points, "raw": raw, "expanded": expanded,
