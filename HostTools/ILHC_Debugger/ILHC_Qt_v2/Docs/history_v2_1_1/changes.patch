+        self.assertGreater(r["length"], straight)               # 比直线长
+        self.assertLess(r["length"], straight * 1.6)            # 但代价可接受
+        self.assertGreater(r["min_clearance"], 0.0)             # 真实余量 > 0
+        # 拉直：航点数明显少于网格原始路径
+        self.assertLess(len(r["points"]), len(r["raw"]))
