+        self.scene_obj.addItem(self.path_dots)
+
+        # 车体：按实际尺寸绘制的顶视轮廓，随航向旋转（长28cm 沿车头、宽26cm 沿车左）
+        self.car_item = QGraphicsPolygonItem()
+        self.car_item.setBrush(QBrush(QColor("#FF9F43")))
+        self.car_item.setPen(QPen(QColor("#FFFFFF"), 3))
