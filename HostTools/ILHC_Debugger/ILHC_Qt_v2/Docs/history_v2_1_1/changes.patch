-# A* 路径规划（仅上位机计算与显示，不下发 STM32）
-#   场地离散成网格，禁区按车体尺寸向外膨胀（把车当质点）；8 邻域搜索，
-#   代价=实际步长、启发=到目标的欧氏距离（可采纳 ⇒ 结果最优）；
-#   出网格路径后用"视线可达"拉直一次，消除 45° 锯齿。
-# ======================================================================
-GRID_MM = 100.0                 # 默认网格步长
-CAR_INFLATE_MM = 150.0          # 默认车体膨胀：介于半宽130/半长140 与半对角线191 之间
-CAR_HALF_DIAG_MM = math.hypot(CAR_LENGTH_MM / 2.0, CAR_WIDTH_MM / 2.0)   # ≈191.0
-
-
-def obstacles_with_pad(pad, rects=None, circles=None):
-    """把禁区按 pad 向外膨胀（车体尺寸 → 点模型）。"""
-    rects = FIELD_FORBIDDEN_RECTS if rects is None else rects
-    circles = FIELD_FORBIDDEN_CIRCLES if circles is None else circles
-    return ([(x0 - pad, y0 - pad, x1 + pad, y1 + pad, name) for x0, y0, x1, y1, name in rects],
-            [(cx, cy, r + pad, name) for cx, cy, r, name in circles])
-
-
-def _snap_free(x, y, x0, y0, step, blocked, nx, ny, max_ring=8):
-    """把点吸附到最近的空闲网格点，返回 (i, j)；找不到返回 None。"""
-    i0 = min(nx - 1, max(0, int(round((x - x0) / step))))
-    j0 = min(ny - 1, max(0, int(round((y - y0) / step))))
-    for ring in range(max_ring + 1):
-        best = None
-        for di in range(-ring, ring + 1):
-            for dj in range(-ring, ring + 1):
-                if max(abs(di), abs(dj)) != ring:
-                    continue
-                i, j = i0 + di, j0 + dj
-                if 0 <= i < nx and 0 <= j < ny and not blocked[i][j]:
-                    d = di * di + dj * dj
-                    if best is None or d < best[0]:
-                        best = (d, i, j)
-        if best is not None:
-            return best[1], best[2]
-    return None
-
-
-def simplify_path(points, rects, circles):
-    """视线拉直：从当前点贪心跳到最远可达点，删掉中间网格拐点。"""
-    if len(points) <= 2:
-        return list(points)
-    out = [points[0]]
-    i = 0
-    while i < len(points) - 1:
-        j = len(points) - 1
-        while j > i + 1 and seg_blocked(points[i][0], points[i][1],
-                                        points[j][0], points[j][1], rects, circles):
-            j -= 1
-        out.append(points[j])
-        i = j
-    return out
-
-
-def path_length(points):
-    return sum(math.hypot(points[k + 1][0] - points[k][0], points[k + 1][1] - points[k][1])
-               for k in range(len(points) - 1))
-
-
-def _dist_to_rect(x, y, rect):
-    x0, y0, x1, y1 = rect[:4]
-    return math.hypot(max(x0 - x, 0.0, x - x1), max(y0 - y, 0.0, y - y1))
-
-
-def path_clearance(points, rects=None, circles=None, sample=50.0):
-    """路径（逐段等距采样）到**真实**障碍表面的最小距离 mm。
-
-    膨胀量只是规划用的保守模型，这个值才是实际余量：0 表示压线或进入障碍。
-    拿它和车半宽(130)/半对角线(191)比较即可判断能不能真走过去。
-    """
-    rects = FIELD_FORBIDDEN_RECTS if rects is None else rects
-    circles = FIELD_FORBIDDEN_CIRCLES if circles is None else circles
-    best = float("inf")
-    for k in range(len(points) - 1):
-        (ax, ay), (bx, by) = points[k], points[k + 1]
-        seg = math.hypot(bx - ax, by - ay)
-        n = max(1, int(seg / max(10.0, sample)))
-        for t in range(n + 1):
-            f = t / n
-            x, y = ax + (bx - ax) * f, ay + (by - ay) * f
-            d = min([_dist_to_rect(x, y, r) for r in rects] +
-                    [math.hypot(x - cx, y - cy) - r for cx, cy, r, _ in circles])
-            if d < best:
-                best = d
-                if best <= 0.0:
-                    return 0.0
-    return 0.0 if best == float("inf") else best
-
