-    @staticmethod
-    def _drain_queue(q):
-        while True:
-            try:
-                q.get_nowait()
-            except queue.Empty:
-                return
-
-    def _clear_command_queues(self):
-        self._manual_stop()
-        self._drain_queue(self.line_q)
-        self._drain_queue(self.urgent_q)
-        self._drain_queue(self.param_q)
