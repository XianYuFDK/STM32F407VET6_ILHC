+        for hx in (1075, 1200, 1325):
+            self._field_circle(hx, 75, 24, "#7D8793", "#4B535F", 1)
+        self._add_centered_text("粗加工区", 1200, 255, "#454B55", 10, True)
+
+        # 二维码板
