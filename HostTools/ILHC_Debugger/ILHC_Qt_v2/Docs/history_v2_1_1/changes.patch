-            self.trail_item.setPath(QPainterPath())
-            return
-        path = QPainterPath(QPointF(float(x[0]), self.sy(float(y[0]))))
-        for xx, yy in zip(x[1:], y[1:]):
-            path.lineTo(float(xx), self.sy(float(yy)))
-        self.trail_item.setPath(path)
