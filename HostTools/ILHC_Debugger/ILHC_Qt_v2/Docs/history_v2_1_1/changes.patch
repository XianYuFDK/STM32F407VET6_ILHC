-                               ("#19799B" if key in keys else "#242A33"))
-        forward = int(Qt.Key_W in keys) - int(Qt.Key_S in keys)
-        left = int(Qt.Key_A in keys) - int(Qt.Key_D in keys)
-        turn = int(Qt.Key_Q in keys) - int(Qt.Key_E in keys)
