+    def test_independent_dijkstra_40_scenes(self):
+        rng=random.Random(7429)
+        for case in range(40):
+            circles=[(rng.uniform(300,700),rng.uniform(200,800),rng.uniform(20,65),'p') for _ in range(3)]
+            rects=[(450,0,550,650,'wall')]
+            scene=nav.CollisionScene(rects,circles,(0,0,1000,1000),10)
+            start=(100.,500.);goal=(900.,500.)
+            r=core.plan_path(start,goal,grid=100,pad=10,rects=rects,circles=circles,bounds=(0,0,1000,1000))
+            nodes=[(i*100.,j*100.) for i in range(11) for j in range(11)
+                   if scene.segment_reason((i*100.,j*100.),(i*100.,j*100.)) is None]
+            # At most 8 cells from start/goal here covers all relevant free cells.
+            src={p:math.dist(start,p) for p in nodes if abs(p[0]/100-1)<=8 and abs(p[1]/100-5)<=8
+                 and scene.segment_reason(start,p) is None}
+            ends={p:math.dist(goal,p) for p in nodes if abs(p[0]/100-9)<=8 and abs(p[1]/100-5)<=8
+                  and scene.segment_reason(goal,p) is None}
+            dist=dict(src); q=[(d,p) for p,d in src.items()]; heapq.heapify(q); best=math.inf
+            if scene.segment_reason(start,goal) is None: best=math.dist(start,goal)
+            node_set=set(nodes)
+            while q:
+                d,p=heapq.heappop(q)
+                if d!=dist[p] or d>=best: continue
+                if p in ends: best=min(best,d+ends[p])
+                for dx,dy in ((100,0),(-100,0),(0,100),(0,-100),(100,100),(100,-100),(-100,100),(-100,-100)):
+                    n=(p[0]+dx,p[1]+dy)
+                    if n not in node_set or scene.segment_reason(p,n): continue
+                    nd=d+math.hypot(dx,dy)
+                    if nd<dist.get(n,math.inf): dist[n]=nd;heapq.heappush(q,(nd,n))
+            with self.subTest(scene=case):
+                self.assertEqual(r['ok'],math.isfinite(best))
+                if r['ok']: self.assertAlmostEqual(r['search_cost'],best,places=6)
