* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 10pt;
    color: #DCE3ED;
}

QMainWindow, QWidget {
    background: #14181E;
}

QFrame#TopBar {
    background: #191E25;
    border-bottom: 1px solid #2A313A;
}
QFrame#Sidebar {
    background: #171B21;
    border-right: 1px solid #252C35;
}
QFrame#Content {
    background: #14181E;
}
QFrame#Footer {
    background: #171B21;
    border-top: 1px solid #252C35;
}
QFrame#Panel, QFrame#StatCard, QFrame#ParamRow {
    background: #1E232B;
    border: 1px solid #2B333D;
    border-radius: 10px;
}
QFrame#ParamRow:hover {
    border-color: #3B4654;
    background: #222831;
}

QLabel#AppTitle {
    font-size: 15pt;
    font-weight: 700;
    letter-spacing: 1px;
    color: #F2F6FA;
}
QLabel#AppSubtitle,
QLabel#PageSubtitle,
QLabel#AppSubtitle,
QLabel#HintLabel,
QLabel#PathLabel,
QLabel#VersionLabel,
QLabel#CardUnit,
QLabel#ParamDesc,
QLabel#SidebarSection {
    color: #8F9BAB;
}
QLabel#SidebarSection {
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 4px 8px;
}
QLabel#PageTitle {
    font-size: 18pt;
    font-weight: 700;
    color: #F5F8FB;
}
QLabel#SectionTitle {
    font-size: 10pt;
    font-weight: 700;
    color: #BFC9D5;
    letter-spacing: 1px;
}
QLabel#CardTitle {
    font-size: 9pt;
    color: #8F9BAB;
}
QLabel#CardValue {
    font-family: "Consolas", "JetBrains Mono", monospace;
    font-size: 19pt;
    font-weight: 700;
    color: #F5F8FB;
}
QLabel#CardUnit {
    font-size: 9pt;
    padding-top: 9px;
}
QLabel#HealthItem {
    padding: 7px 4px;
    border-bottom: 1px solid #2A313A;
    color: #BFC9D5;
}
QLabel#ParamCmd {
    font-family: "Consolas", monospace;
    font-weight: 700;
    color: #4FC3F7;
}
QLabel#Readback {
    font-family: "Consolas", monospace;
    color: #7DDAA3;
}
QLabel#StatusPill {
    background: #232A33;
    border: 1px solid #323B47;
    border-radius: 14px;
    padding: 5px 10px;
    font-weight: 600;
}
QLabel#StatusPill[state="ok"] { color: #5AD68A; border-color: #315D45; background: #1A2B22; }
QLabel#StatusPill[state="warn"] { color: #FFB74D; border-color: #66512C; background: #2B2519; }
QLabel#StatusPill[state="error"] { color: #FF7078; border-color: #6A3438; background: #2C1D20; }
QLabel#StatusPill[state="sim"] { color: #57D7D0; border-color: #2D5D5A; background: #192928; }
QLabel#StatusPill[state="idle"] { color: #8F9BAB; }

QPushButton {
    background: #252C35;
    border: 1px solid #343E49;
    border-radius: 7px;
    padding: 7px 12px;
    color: #DCE3ED;
}
QPushButton:hover {
    background: #303944;
    border-color: #465361;
}
QPushButton:pressed {
    background: #1C2229;
}
QPushButton[nav="true"] {
    text-align: left;
    border: none;
    background: transparent;
    color: #98A5B4;
    padding: 10px 12px;
    border-radius: 8px;
}
QPushButton[nav="true"]:hover {
    background: #202630;
    color: #E2E8EF;
}
QPushButton[nav="true"][detached="true"] {
    color: #65CCF5;
    border-left: 3px solid #2E6A85;
}
QPushButton[nav="true"][active="true"] {
    background: #203442;
    color: #65CCF5;
    font-weight: 700;
    border-left: 3px solid #4FC3F7;
}
QFrame#DetachBar {
    background: #1B2129;
    border-bottom: 1px solid #2A313A;
}
QLabel#DetachTitle {
    font-weight: 700;
    color: #E6EDF5;
}
QPushButton#PrimaryButton,
QPushButton#SmallPrimary,
QPushButton#ConnectButton {
    background: #1E5B7A;
    border-color: #28789E;
    color: #EAF8FF;
    font-weight: 700;
}
QPushButton#PrimaryButton:hover,
QPushButton#SmallPrimary:hover,
QPushButton#ConnectButton:hover {
    background: #246F94;
}
QPushButton#SuccessButton {
    background: #215A3B;
    border-color: #2F7A51;
    color: #DFF8E9;
    font-weight: 700;
}
QPushButton#WarningButton {
    background: #674719;
    border-color: #8A6125;
    color: #FFE9C1;
    font-weight: 700;
}
QPushButton#EmergencyButton,
QPushButton#RecordButton {
    background: #722C33;
    border-color: #9A3A43;
    color: #FFE6E8;
    font-weight: 700;
}
QPushButton#EmergencyButton:hover,
QPushButton#RecordButton:hover {
    background: #89363E;
}

QComboBox, QLineEdit, QDoubleSpinBox, QSpinBox {
    background: #171B21;
    border: 1px solid #343E49;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #295C78;
}
QComboBox:hover, QLineEdit:hover, QDoubleSpinBox:hover, QSpinBox:hover {
    border-color: #4A5968;
}
QComboBox::drop-down {
    width: 22px;
    border: none;
}
QComboBox QAbstractItemView {
    background: #1D232B;
    border: 1px solid #343E49;
    selection-background-color: #29475B;
    outline: none;
}

QSlider::groove:horizontal {
    height: 5px;
    background: #303843;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #3C8FB8;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: #63C7EE;
    border: 1px solid #8AD8F5;
}

QTreeWidget {
    background: #171B21;
    border: 1px solid #2D3540;
    border-radius: 7px;
    outline: none;
}
QTreeWidget::item {
    padding: 5px 3px;
}
QTreeWidget::item:selected {
    background: #28495D;
}

QScrollArea {
    border: none;
    background: transparent;
}
QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 1px;
}
QScrollBar::handle:vertical {
    background: #3B4551;
    min-height: 28px;
    border-radius: 4px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QTextEdit#Console {
    background: #101318;
    border: 1px solid #2B333D;
    border-radius: 9px;
    font-family: "Consolas", "JetBrains Mono", monospace;
    font-size: 9.5pt;
    selection-background-color: #29475B;
}

QLabel#DmStatus {
    background: #20262E;
    border: 1px solid #343E49;
    border-radius: 8px;
    padding: 10px 12px;
    font-weight: 700;
    color: #8F9BAB;
}
QLabel#DmStatus[enabled="true"] {
    color: #5AD68A;
    border-color: #315D45;
    background: #1A2B22;
}
QLabel#DmStatus[fault="true"] {
    color: #FF7078;
    border-color: #6A3438;
    background: #2C1D20;
}
QLabel#RecordState {
    font-size: 15pt;
    font-weight: 700;
}

QGraphicsView#FieldView {
    background: #11151A;
    border: 1px solid #2B333D;
    border-radius: 10px;
}

/* A* 规划侧栏 */
QTextEdit#PlanText {
    background: #101318;
    border: 1px solid #2B333D;
    border-radius: 9px;
    font-family: "Consolas", "JetBrains Mono", monospace;
    font-size: 8.5pt;
    selection-background-color: #29475B;
}
QLabel#PlanInfo {
    background: #20262E;
    border: 1px solid #343E49;
    border-radius: 8px;
    padding: 8px 10px;
    color: #A9B4C2;
    font-size: 8.5pt;
}
QLabel#PlanInfo[state="ok"] {
    color: #5AD68A; border-color: #315D45; background: #1A2B22;
}
QLabel#PlanInfo[state="warn"] {
    color: #FFB74D; border-color: #66512C; background: #2B2519;
}
QLabel#PlanInfo[state="bad"] {
    color: #FF7078; border-color: #6A3438; background: #2C1D20;
}
QLabel#PlanBadge {
    color: #FFB74D;
    background: #2B2519;
    border: 1px solid #66512C;
    border-radius: 8px;
    padding: 3px 8px;
    font-size: 8.5pt;
    font-weight: 700;
}

/* DM 调试页：地址设置、分组卡片与明确的操作层级。 */
QFrame#DmToolbar, QFrame#DmCard {
    background: #1B2129;
    border: 1px solid #2B3541;
    border-radius: 12px;
}
QFrame#DmAddressSetting, QWidget#DmAdvancedBody {
    background: transparent;
    border: none;
}
QFrame#DmToolbar QLabel, QWidget#DmPositionPanel QLabel {
    background: transparent;
}
QFrame#DmToolbar QLabel#DmAddressReadback {
    color: #7DDAA3;
    background: #182B23;
    border: 1px solid #2D4B3C;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 9pt;
}
QWidget#DmPositionPanel QLabel#DmCardTitle {
    font-size: 12pt;
    font-weight: 700;
    color: #EDF3FA;
}
QWidget#DmPositionPanel QLabel#DmFieldLabel {
    color: #9AAABC;
    font-size: 9pt;
}
QFrame#DmPresetRow {
    background: #202832;
    border: 1px solid #2C3948;
    border-radius: 8px;
}
QWidget#DmPositionPanel QLabel#DmPresetState {
    color: #8EADBD;
    font-size: 8.5pt;
}
QWidget#DmPositionPanel QLabel#HintLabel {
    color: #8799AA;
    font-size: 8.5pt;
}
QWidget#DmPositionPanel QLabel#DmFeedback {
    color: #7DD1F2;
    background: #172D3A;
    border: 1px solid #274759;
    border-radius: 7px;
    padding: 9px 10px;
}
QWidget#DmPositionPanel QLabel#DmWorkflowStatus {
    color: #ADBFCF;
    background: #161D25;
    border-radius: 7px;
    padding: 8px 10px;
    font-size: 9pt;
}
QWidget#DmPositionPanel QPushButton#DmDisclosure {
    background: transparent;
    border: none;
    text-align: left;
    color: #B8CDDF;
    font-weight: 700;
    padding: 2px 0;
}
QWidget#DmPositionPanel QPushButton#DmDisclosure:hover {
    color: #66CFF7;
}
QWidget#DmPositionPanel QCheckBox {
    background: transparent;
    spacing: 7px;
    padding: 2px 0;
}
QWidget#DmPositionPanel QPushButton {
    padding: 6px 10px;
}
QWidget#DmPositionPanel QPushButton:disabled {
    background: #1A222B;
    border-color: #293441;
    color: #5C6D7F;
}
QWidget#DmPositionPanel QDoubleSpinBox:disabled,
QWidget#DmPositionPanel QComboBox:disabled {
    color: #68798A;
    border-color: #293441;
}

/* 28/35 页面：机械目标优先，通信反馈与原始参数分组。 */
QFrame#StepperCard {
    background: #1B2129;
    border: 1px solid #2B3541;
    border-radius: 12px;
}
QWidget#StepperBody, QWidget#StepperRawBody, QScrollArea#StepperScroll {
    background: transparent;
    border: none;
}
QWidget#StepperPage QLabel {
    background: transparent;
}
QFrame#StepperNotice {
    background: #29251F;
    border: 1px solid #514332;
    border-radius: 8px;
}
QFrame#StepperNotice QLabel {
    color: #D8BC93;
    font-size: 9pt;
}
QWidget#StepperPage QLabel#StepperNumber {
    background: #173344;
    border: 1px solid #29526A;
    border-radius: 10px;
    color: #6ED1F6;
    font-size: 19pt;
    font-weight: 700;
}
QWidget#StepperPage QLabel#StepperTitle {
    font-size: 14pt;
    font-weight: 700;
    color: #EDF3FA;
}
QWidget#StepperPage QLabel#StepperSection {
    font-size: 10pt;
    font-weight: 700;
    color: #BDD1E1;
    padding-top: 4px;
}
QWidget#StepperPage QLabel#StepperHint {
    color: #899CAC;
    font-size: 8.5pt;
}
QWidget#StepperPage QLabel#StepperFeedback {
    color: #9FCFE2;
    background: #172A36;
    border: 1px solid #29414F;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 9pt;
}
QWidget#StepperPage QDoubleSpinBox#StepperTarget {
    font-size: 16pt;
    font-weight: 600;
    color: #F2F7FC;
}
QWidget#StepperPage QPushButton {
    padding: 7px 10px;
}
QWidget#StepperPage QPushButton#StepperDisclosure {
    background: transparent;
    border: none;
    text-align: left;
    color: #B4CCDE;
    padding: 4px 0;
    font-weight: 600;
}
QWidget#StepperPage QPushButton#StepperDisclosure:hover {
    color: #69D0F5;
}
